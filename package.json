{
  "name": "a2aroom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && wrangler deploy --dry-run --outdir dist/worker",
    "test": "tsx --test tests/*.test.ts",
    "verify": "npm run build && npm run test",
    "db:local": "wrangler d1 migrations apply a2aroom-local --local"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@radix-ui/react-select": "^2.4.1",
    "hono": "^4.13.19",
    "ipaddr.js": "^2.2.0",
    "jose": "6.2.18",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261120.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261119.0-beta",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.166.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/x2547412/a2aroom.git"
  },
  "license": "MIT"
}
